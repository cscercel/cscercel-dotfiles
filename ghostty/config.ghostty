# Font
font-family = "JetBrainsMonoNL Nerd Font Mono"
font-size = 11

# Window Padding
window-padding-x = 2
window-padding-y = 2

# Disable close confirmation
confirm-close-surface = false

# Disable bell
bell-features = false

# Cursor
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false

# Theme
theme = rose-pine-moon-dragon
